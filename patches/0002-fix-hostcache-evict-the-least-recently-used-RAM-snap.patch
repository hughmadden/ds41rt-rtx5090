+/// The snapshot RAM eviction deletes next, from `(key, kind, last_use)` of the unpinned
+/// snapshots: the least recently used; at equal use a prompt snapshot before a turn snapshot.
+/// A conversation's prompt snapshot is stored before its turn snapshot, so a stale pair goes
+/// prompt first; across conversations age decides, whatever the bank.
+fn victim(snapshots: impl Iterator<Item = (Key, SnapshotKind, u64)>) -> Option<Key> {
+    snapshots
+        .min_by_key(|&(_, kind, last_use)| (last_use, kind == SnapshotKind::Turn))
+        .map(|(key, _, _)| key)
+}
